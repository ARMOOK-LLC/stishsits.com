{
  "expo": {
    "name": "Stish Sits (testnet)",
    "slug": "stishsits",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060c",
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.stishsits.testnet" },
    "android": { "package": "com.stishsits.testnet" },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Stish Sits uses motion sensors to time how long you sit still during a testnet contest."
        }
      ]
    ],
    "extra": { "network": "testnet" }
  }
}
