# Copy to .env for local dev. NEVER commit a real .env or a real key.
PORT=8787
HOST=127.0.0.1
# Only "localnet" or "testnet" are accepted. The server refuses to start on anything else.
ALGORAND_NETWORK=testnet
# Contest escrow app id on testnet (0 = not deployed yet)
CONTEST_APP_ID=0
# Referee result-signing key: base64 of a 32-byte ed25519 seed. Leave EMPTY in dev to run with signing disabled.
# In production this comes from a KMS/HSM, not an env file.
RESULT_SIGNER_SEED_B64=
# Secret used to derive unpredictable pulse times (any long random string; generate your own)
PULSE_SECRET=
